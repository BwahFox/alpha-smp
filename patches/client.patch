+		this.controlList.add(new GuiButton(1, this.width / 2 + 2, var1, 98, 20, "Snd: mob.creeper"));
+		this.controlList.add(new GuiButton(2, this.width / 2 - 100, var1 + 24, 98, 20, "Snd: random.fuse"));
+		this.controlList.add(new GuiButton(11, this.width / 2 + 2, var1 + 24, 98, 20, "Give item..."));
+		this.controlList.add(new GuiButton(3, this.width / 2 - 100, var1 + 56, 98, 20, "Explode (SP)"));
