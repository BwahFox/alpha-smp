+package net.minecraft.src;
+
+/**
+ * The player's own inventory window (PARITY A1-A3) — windowId 0, alive for the whole
+ * session. Slot order mirrors the client's GuiInventory/ContainerPlayer exactly:
+ * 0 result, 1-4 craft grid (2x2), 5-8 armor (helmet down), 9-35 main, 36-44 hotbar.
+ *
+ * Two deliberate alpha-isms, both diverging from b1.7.3/NSSS:
+ *  - the craft matrix WRAPS gm.c (the NBT-persisted 2x2 grid, slots 80-83), so grid
+ *    contents survive closing the GUI and logging out, exactly like alpha SP
+ *  - onCraftGuiClosed does NOT drop the grid (only the cursor stack), for the same
+ *    reason — do not "fix" this to match beta
+ */
+public class ContainerPlayer extends Container {
+    public InventoryCrafting craftMatrix;
+    public iw craftResult = new InventoryCraftResult();
+
+    public ContainerPlayer(gm inventory) {
+        this.craftMatrix = new InventoryCrafting(this, inventory.c);
+        this.addSlot(new SlotCrafting(this.craftMatrix, this.craftResult, 0, 144, 36));
+        for (int row = 0; row < 2; ++row) {
+            for (int col = 0; col < 2; ++col) {
+                this.addSlot(new Slot(this.craftMatrix, col + row * 2, 88 + col * 18, 26 + row * 18));
+            }
+        }
+        for (int i = 0; i < 4; ++i) {
+            // getSizeInventory()-1-i: armor lives after main in gm's flat indexing
+            this.addSlot(new SlotArmor(inventory, inventory.a() - 1 - i, 8, 8 + i * 18, i));
+        }
+        for (int row = 0; row < 3; ++row) {
+            for (int col = 0; col < 9; ++col) {
+                this.addSlot(new Slot(inventory, col + (row + 1) * 9, 8 + col * 18, 84 + row * 18));
+            }
+        }
+        for (int i = 0; i < 9; ++i) {
+            this.addSlot(new Slot(inventory, i, 8 + i * 18, 142));
+        }
+        this.onCraftMatrixChanged(this.craftMatrix);
+    }
+
+    public void onCraftMatrixChanged(iw inv) {
+        // the client's CraftingInventoryPlayerCB mapping: 2x2 grid into the
+        // top-left of the 3x3 recipe window, -1 padding elsewhere
+        int[] ids = new int[9];
+        for (int col = 0; col < 3; ++col) {
+            for (int row = 0; row < 3; ++row) {
+                int id = -1;
+                if (col < 2 && row < 2) {
+                    gp stack = this.craftMatrix.a(col + row * 2);
+                    if (stack != null) {
+                        id = stack.c;
+                    }
+                }
+                ids[col + row * 3] = id;
+            }
+        }
+        this.craftResult.setSlotContents(0, CraftingManager.getInstance().findMatchingRecipe(ids));
+    }
+
+    public boolean canInteractWith(fc player) {
+        return true;
+    }
+}
