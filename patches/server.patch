+        return this.name;
+    }
+
+    public gp decrStackSize(int n, int count) {
+        if (this.stacks[n] == null) {
+            return null;
+        }
+        gp taken;
+        if (this.stacks[n].a <= count) {
+            taken = this.stacks[n];
+            this.stacks[n] = null;
+        } else {
+            taken = this.stacks[n].splitStack(count);
+            if (this.stacks[n].a == 0) {
+                this.stacks[n] = null;
+            }
+        }
+        return taken;
+    }
+
+    public void setSlotContents(int n, gp stack) {
+        this.stacks[n] = stack;
+        if (stack != null && stack.a > this.getStackLimit()) {
