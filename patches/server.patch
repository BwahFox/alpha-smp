+package net.minecraft.src;
+
+/**
+ * Chest window (PARITY A2). Slot order mirrors the client's GuiChest: chest rows
+ * first, then player main (9-35), then hotbar (0-8). Works for single (27) and
+ * double (54, via ah/InventoryLargeChest) chests — the row count scales.
+ */
+public class ContainerChest extends Container {
+    private iw chestInventory;
+
+    public ContainerChest(iw playerInventory, iw chestInventory) {
+        this.chestInventory = chestInventory;
+        int rows = chestInventory.a() / 9;
+        int yOff = (rows - 4) * 18;
+        for (int row = 0; row < rows; ++row) {
+            for (int col = 0; col < 9; ++col) {
+                this.addSlot(new Slot(chestInventory, col + row * 9, 8 + col * 18, 18 + row * 18));
+            }
+        }
+        for (int row = 0; row < 3; ++row) {
+            for (int col = 0; col < 9; ++col) {
+                this.addSlot(new Slot(playerInventory, col + (row + 1) * 9, 8 + col * 18, 103 + row * 18 + yOff));
+            }
+        }
+        for (int i = 0; i < 9; ++i) {
+            this.addSlot(new Slot(playerInventory, i, 8 + i * 18, 161 + yOff));
+        }
+    }
+
+    public boolean canInteractWith(fc player) {
+        return this.chestInventory.canInteractWith(player);
+    }
+}
