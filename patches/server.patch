--- /dev/null
+++ b/ours/net/minecraft/src/DataWatcher.java
@@ -0,0 +1,197 @@
+package net.minecraft.src;
+
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Per-entity bag of small values mirrored onto every client watching that entity —
+ * creeper swell, sheep wool, pig saddle, slime size, the shared entity flags.
+ *
+ * Does not exist in vanilla a1.1.2_01 in any form, on either side. Alpha holds all of
+ * this in ordinary fields that only the owning side ever sees, so in multiplayer every
+ * sheep is white and unsheared and a creeper gives no visual warning before detonating.
+ * Ported from b1.7.3 via reference/nsss/.
+ *
+ * Wire format: one header byte per entry, (type << 5 | id & 31), then the payload;
+ * 127 terminates. Ids cap at 31 because only 5 bits carry them.
+ *
+ * Types 5 (ItemStack) and 6 (ChunkCoordinates) from b1.7.3 are deliberately NOT
+ * implemented — everything alpha watches is a Byte, and those two exist for beta
+ * features alpha lacks. The numbers are left as gaps rather than renumbered, so adding
+ * them later means filling in the switch arms on both sides. Keep this file and the
+ * client's copy identical in behaviour.
+ */
+public class DataWatcher {
+    private static final HashMap dataTypes = new HashMap();
+    private final Map watchedObjects = new HashMap();
+    private boolean objectChanged;
+
+    public void addObject(int n2, Object object) {
+        Integer n3 = (Integer)dataTypes.get(object.getClass());
+        if (n3 == null) {
+            throw new IllegalArgumentException("Unknown data type: " + object.getClass());
+        }
+        if (n2 > 31) {
+            throw new IllegalArgumentException("Data value id is too big with " + n2 + "! (Max is 31)");
+        }
+        if (this.watchedObjects.containsKey(Integer.valueOf(n2))) {
+            throw new IllegalArgumentException("Duplicate id value for " + n2 + "!");
+        }
+        this.watchedObjects.put(Integer.valueOf(n2), new WatchableObject(n3.intValue(), n2, object));
+    }
+
+    public byte getWatchableObjectByte(int n2) {
+        return ((Byte)((WatchableObject)this.watchedObjects.get(Integer.valueOf(n2))).getObject()).byteValue();
+    }
+
+    public short getWatchableObjectShort(int n2) {
+        return ((Short)((WatchableObject)this.watchedObjects.get(Integer.valueOf(n2))).getObject()).shortValue();
+    }
+
+    public int getWatchableObjectInteger(int n2) {
+        return ((Integer)((WatchableObject)this.watchedObjects.get(Integer.valueOf(n2))).getObject()).intValue();
+    }
+
+    public String getWatchableObjectString(int n2) {
+        return (String)((WatchableObject)this.watchedObjects.get(Integer.valueOf(n2))).getObject();
+    }
+
+    public void updateObject(int n2, Object object) {
+        WatchableObject watchableObject = (WatchableObject)this.watchedObjects.get(Integer.valueOf(n2));
+        if (!object.equals(watchableObject.getObject())) {
+            watchableObject.setObject(object);
+            watchableObject.setWatching(true);
+            this.objectChanged = true;
+        }
+    }
+
+    public boolean hasObjectChanged() {
+        return this.objectChanged;
+    }
+
+    /**
+     * Entries changed since the last call, clearing their dirty flags. Returns null
+     * rather than an empty list when nothing changed — callers rely on that.
+     */
+    public ArrayList getChangedObjects() {
+        ArrayList<WatchableObject> arrayList = null;
+        if (this.objectChanged) {
+            for (Object object : this.watchedObjects.values()) {
+                WatchableObject watchableObject = (WatchableObject)object;
+                if (!watchableObject.getWatching()) continue;
+                watchableObject.setWatching(false);
+                if (arrayList == null) {
+                    arrayList = new ArrayList<WatchableObject>();
+                }
+                arrayList.add(watchableObject);
+            }
+        }
+        this.objectChanged = false;
+        return arrayList;
+    }
+
+    /** Every entry, dirty or not — used to seed a client that has just started watching. */
+    public ArrayList getAllObjects() {
+        ArrayList<WatchableObject> arrayList = new ArrayList<WatchableObject>();
+        for (Object object : this.watchedObjects.values()) {
+            arrayList.add((WatchableObject)object);
+        }
+        return arrayList;
+    }
+
+    public static void writeObjectsInListToStream(List list, DataOutputStream dataOutputStream) throws IOException {
+        if (list != null) {
+            Iterator iterator = list.iterator();
+            while (iterator.hasNext()) {
+                DataWatcher.writeWatchableObject(dataOutputStream, (WatchableObject)iterator.next());
+            }
+        }
+        dataOutputStream.writeByte(127);
+    }
+
+    public void writeWatchableObjects(DataOutputStream dataOutputStream) throws IOException {
+        for (Object object : this.watchedObjects.values()) {
+            DataWatcher.writeWatchableObject(dataOutputStream, (WatchableObject)object);
+        }
+        dataOutputStream.writeByte(127);
+    }
+
+    private static void writeWatchableObject(DataOutputStream dataOutputStream, WatchableObject watchableObject) throws IOException {
+        int n2 = (watchableObject.getObjectType() << 5 | watchableObject.getDataValueId() & 31) & 0xFF;
+        dataOutputStream.writeByte(n2);
+        switch (watchableObject.getObjectType()) {
+            case 0: {
+                dataOutputStream.writeByte(((Byte)watchableObject.getObject()).byteValue());
+                break;
+            }
+            case 1: {
+                dataOutputStream.writeShort(((Short)watchableObject.getObject()).shortValue());
+                break;
+            }
+            case 2: {
+                dataOutputStream.writeInt(((Integer)watchableObject.getObject()).intValue());
+                break;
+            }
+            case 3: {
+                dataOutputStream.writeFloat(((Float)watchableObject.getObject()).floatValue());
+                break;
+            }
+            case 4: {
+                dataOutputStream.writeUTF((String)watchableObject.getObject());
+            }
+        }
+    }
+
+    public static List readWatchableObjects(DataInputStream dataInputStream) throws IOException {
+        ArrayList<WatchableObject> arrayList = null;
+        for (byte by = dataInputStream.readByte(); by != 127; by = dataInputStream.readByte()) {
+            WatchableObject watchableObject;
+            if (arrayList == null) {
+                arrayList = new ArrayList<WatchableObject>();
+            }
+            int n2 = (by & 0xE0) >> 5;
+            int n3 = by & 0x1F;
+            switch (n2) {
+                case 0: {
+                    watchableObject = new WatchableObject(n2, n3, Byte.valueOf(dataInputStream.readByte()));
+                    break;
+                }
+                case 1: {
+                    watchableObject = new WatchableObject(n2, n3, Short.valueOf(dataInputStream.readShort()));
+                    break;
+                }
+                case 2: {
+                    watchableObject = new WatchableObject(n2, n3, Integer.valueOf(dataInputStream.readInt()));
+                    break;
+                }
+                case 3: {
+                    watchableObject = new WatchableObject(n2, n3, Float.valueOf(dataInputStream.readFloat()));
+                    break;
+                }
+                case 4: {
+                    watchableObject = new WatchableObject(n2, n3, dataInputStream.readUTF());
+                    break;
+                }
+                default: {
+                    throw new IOException("Unsupported DataWatcher type " + n2 + " (5 and 6 are not implemented, see DataWatcher)");
+                }
+            }
+            arrayList.add(watchableObject);
+        }
+        return arrayList;
+    }
+
+    static {
+        dataTypes.put(Byte.class, Integer.valueOf(0));
+        dataTypes.put(Short.class, Integer.valueOf(1));
+        dataTypes.put(Integer.class, Integer.valueOf(2));
+        dataTypes.put(Float.class, Integer.valueOf(3));
+        dataTypes.put(String.class, Integer.valueOf(4));
+    }
+}
