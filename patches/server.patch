+package net.minecraft.src;
+
+/**
+ * Furnace window (PARITY A2). Slot order mirrors the client's GuiFurnace: 0 input,
+ * 1 fuel, 2 output, 3-29 main, 30-38 hotbar. Progress rides packet 105: bar 0 is
+ * cook time (df.h), bar 1 burn time (df.f), bar 2 the current fuel's total burn
+ * (df.g) — which the client needs to scale the flame icon.
+ */
+public class ContainerFurnace extends Container {
+    private df furnace;
+    private int lastCookTime = 0;
+    private int lastBurnTime = 0;
+    private int lastItemBurnTime = 0;
+
+    public ContainerFurnace(gm inventory, df furnace) {
+        this.furnace = furnace;
+        this.addSlot(new Slot(furnace, 0, 56, 17));
+        this.addSlot(new Slot(furnace, 1, 56, 53));
+        this.addSlot(new SlotFurnace(furnace, 2, 116, 35));
+        for (int row = 0; row < 3; ++row) {
+            for (int col = 0; col < 9; ++col) {
+                this.addSlot(new Slot(inventory, col + (row + 1) * 9, 8 + col * 18, 84 + row * 18));
+            }
+        }
+        for (int i = 0; i < 9; ++i) {
+            this.addSlot(new Slot(inventory, i, 8 + i * 18, 142));
+        }
+    }
+
+    public void onCraftGuiOpened(ICrafting listener) {
+        super.onCraftGuiOpened(listener);
+        listener.updateProgressBar(this, 0, this.furnace.h);
+        listener.updateProgressBar(this, 1, this.furnace.f);
+        listener.updateProgressBar(this, 2, this.furnace.g);
+    }
+
+    public void updateCraftingMatrix() {
+        super.updateCraftingMatrix();
+        for (int i = 0; i < this.crafters.size(); ++i) {
+            ICrafting listener = (ICrafting)this.crafters.get(i);
+            if (this.lastCookTime != this.furnace.h) {
+                listener.updateProgressBar(this, 0, this.furnace.h);
+            }
+            if (this.lastBurnTime != this.furnace.f) {
+                listener.updateProgressBar(this, 1, this.furnace.f);
+            }
+            if (this.lastItemBurnTime != this.furnace.g) {
+                listener.updateProgressBar(this, 2, this.furnace.g);
+            }
+        }
+        this.lastCookTime = this.furnace.h;
+        this.lastBurnTime = this.furnace.f;
+        this.lastItemBurnTime = this.furnace.g;
+    }
+
+    public boolean canInteractWith(fc player) {
+        return this.furnace.canInteractWith(player);
+    }
+}
