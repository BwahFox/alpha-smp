--- /dev/null
+++ b/ours/net/minecraft/src/Container.java
@@ -0,0 +1,217 @@
+package net.minecraft.src;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Server-side Container (PARITY A1-A3), ported from NSSS/b1.7.3 but with the click
+ * semantics of OUR client's GuiContainer.mouseClicked — alpha merges stacks by item
+ * id only (no subtype/damage check; nothing stackable in alpha carries damage), and
+ * there is no shift-click. The wire contract with the client:
+ *
+ *  - slotNumber order is fixed by the subclass constructors, which mirror the
+ *    client's Container constructors line for line
+ *  - clickSlot returns a copy of the clicked slot's ORIGINAL stack; packet 102
+ *    carries the client's expectation of the same value, and a mismatch triggers a
+ *    full window resync (packet 106 reject + 104)
+ *  - updateCraftingMatrix() is the per-tick diff that pushes packet 103s
+ */
+public abstract class Container {
+    /** last-sent copy of each slot, for change detection */
+    public List inventoryItemStacks = new ArrayList();
+    public List inventorySlots = new ArrayList();
+    public int windowId = 0;
+    private short transactionID = 0;
+    protected List crafters = new ArrayList();
+    private Set blockedPlayers = new HashSet();
+
+    protected void addSlot(Slot slot) {
+        slot.slotNumber = this.inventorySlots.size();
+        this.inventorySlots.add(slot);
+        this.inventoryItemStacks.add(null);
+    }
+
+    public void onCraftGuiOpened(ICrafting listener) {
+        if (this.crafters.contains(listener)) {
+            throw new IllegalArgumentException("Listener already listening");
+        }
+        this.crafters.add(listener);
+        listener.updateCraftingInventory(this, this.getStacks());
+        this.updateCraftingMatrix();
+    }
+
+    public boolean isListening(ICrafting listener) {
+        return this.crafters.contains(listener);
+    }
+
+    public List getStacks() {
+        ArrayList list = new ArrayList();
+        for (int i = 0; i < this.inventorySlots.size(); ++i) {
+            list.add(((Slot)this.inventorySlots.get(i)).getStack());
+        }
+        return list;
+    }
+
+    /** detectAndSendChanges — called every player tick from ea.i() */
+    public void updateCraftingMatrix() {
+        for (int i = 0; i < this.inventorySlots.size(); ++i) {
+            gp current = ((Slot)this.inventorySlots.get(i)).getStack();
+            gp known = (gp)this.inventoryItemStacks.get(i);
+            if (!gp.areItemStacksEqual(known, current)) {
+                known = current == null ? null : current.d();
+                this.inventoryItemStacks.set(i, known);
+                for (int j = 0; j < this.crafters.size(); ++j) {
+                    ((ICrafting)this.crafters.get(j)).updateCraftingInventorySlot(this, i, known);
+                }
+            }
+        }
+    }
+
+    public Slot getSlot(int i) {
+        return (Slot)this.inventorySlots.get(i);
+    }
+
+    public gp getStackInSlot(int i) {
+        Slot slot = (Slot)this.inventorySlots.get(i);
+        return slot == null ? null : slot.getStack();
+    }
+
+    /**
+     * The one entry point for every inventory mutation a player can make.
+     * button is 0 (left) or 1 (right); slotNumber -999 means "outside the window"
+     * (drop the cursor stack). Returns a copy of the clicked slot's original
+     * contents for the packet-102 verification. The isShift flag rides the b1.7.3
+     * wire layout but alpha has no shift-click; our client never sets it, and a
+     * modified client setting it just gets a plain click.
+     */
+    public gp clickSlot(int slotNumber, int button, boolean isShift, fc player) {
+        gp result = null;
+        if (button != 0 && button != 1) {
+            return null;
+        }
+        gm inv = player.aj;
+        if (slotNumber == -999) {
+            if (inv.cursorItem != null) {
+                if (button == 0) {
+                    player.a(inv.cursorItem, false);
+                    inv.cursorItem = null;
+                }
+                if (button == 1) {
+                    player.a(inv.cursorItem.splitStack(1), false);
+                    if (inv.cursorItem.a == 0) {
+                        inv.cursorItem = null;
+                    }
+                }
+            }
+            return null;
+        }
+        if (slotNumber < 0 || slotNumber >= this.inventorySlots.size()) {
+            return null;
+        }
+        Slot slot = (Slot)this.inventorySlots.get(slotNumber);
+        if (slot == null) {
+            return null;
+        }
+        slot.onSlotChanged();
+        gp inSlot = slot.getStack();
+        gp cursor = inv.cursorItem;
+        if (inSlot != null) {
+            result = inSlot.d();
+        }
+        if (inSlot == null) {
+            // place from cursor into empty slot
+            if (cursor != null && slot.isItemValid(cursor)) {
+                int n = button == 0 ? cursor.a : 1;
+                if (n > slot.getSlotStackLimit()) {
+                    n = slot.getSlotStackLimit();
+                }
+                slot.putStack(cursor.splitStack(n));
+                if (cursor.a == 0) {
+                    inv.cursorItem = null;
+                }
+            }
+        } else if (cursor == null) {
+            // pick up (all / half)
+            int n = button == 0 ? inSlot.a : (inSlot.a + 1) / 2;
+            gp picked = slot.decrStackSize(n);
+            inv.cursorItem = picked;
+            if (inSlot.a == 0) {
+                slot.putStack(null);
+            }
+            slot.onPickupFromSlot(inv.cursorItem);
+        } else if (slot.isItemValid(cursor)) {
+            if (inSlot.c != cursor.c) {
+                // swap
+                if (cursor.a <= slot.getSlotStackLimit()) {
+                    slot.putStack(cursor);
+                    inv.cursorItem = inSlot;
+                }
+            } else {
+                // merge cursor into slot (alpha: by item id only)
+                int n = button == 0 ? cursor.a : 1;
+                if (n > slot.getSlotStackLimit() - inSlot.a) {
+                    n = slot.getSlotStackLimit() - inSlot.a;
+                }
+                if (n > cursor.b() - inSlot.a) {
+                    n = cursor.b() - inSlot.a;
+                }
+                cursor.splitStack(n);
+                if (cursor.a == 0) {
+                    inv.cursorItem = null;
+                }
+                inSlot.a += n;
+            }
+        } else if (inSlot.c == cursor.c && cursor.b() > 1) {
+            // merge slot into cursor (this is how a craft result stacks onto the cursor)
+            int n = inSlot.a;
+            if (n > 0 && n + cursor.a <= cursor.b()) {
+                cursor.a += n;
+                inSlot.splitStack(n);
+                if (inSlot.a == 0) {
+                    slot.putStack(null);
+                }
+                slot.onPickupFromSlot(inv.cursorItem);
+            }
+        }
+        return result;
+    }
+
+    /** drops the cursor stack; subclasses add their volatile matrices */
+    public void onCraftGuiClosed(fc player) {
+        gm inv = player.aj;
+        if (inv.cursorItem != null) {
+            player.a(inv.cursorItem, false);
+            inv.cursorItem = null;
+        }
+    }
+
+    public void onCraftMatrixChanged(iw inv) {
+        this.updateCraftingMatrix();
+    }
+
+    public void putStackInSlot(int i, gp stack) {
+        this.getSlot(i).putStack(stack);
+    }
+
+    public short getNextTransactionID(gm inv) {
+        return ++this.transactionID;
+    }
+
+    /** false while a rejected transaction is waiting for the client's 106 ack */
+    public boolean getCanCraft(fc player) {
+        return !this.blockedPlayers.contains(player);
+    }
+
+    public void setCanCraft(fc player, boolean canCraft) {
+        if (canCraft) {
+            this.blockedPlayers.remove(player);
+        } else {
+            this.blockedPlayers.add(player);
+        }
+    }
+
+    /** distance / existence check, evaluated per click and per tick */
+    public abstract boolean canInteractWith(fc player);
+}
